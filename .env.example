# 서버 /opt/jandi-band/production/.env에서 수동 관리
# Compose format: raw 사용. 값을 따옴표로 감싸지 않음.
# Tailscale의 TS_CLIENT_ID, TS_AUDIENCE는 GitHub Environment Variables에서 관리
# 운영 JDBC URL: sslMode=VERIFY_CA, /app/tls/mysql-truststore.p12 사용
DB_URL=
DB_USERNAME=
DB_PASSWORD=
JWT_SECRET=
KAKAO_REST_API_KEY=
KAKAO_ADMIN_KEY=
# 카카오 앱에서 클라이언트 시크릿을 사용하는 경우에만 입력
KAKAO_CLIENT_SECRET=
# OCI Object Storage S3 호환 API 자격증명과 버킷·공개 주소
IMAGE_STORAGE_ACCESS_KEY=
IMAGE_STORAGE_SECRET_KEY=
IMAGE_STORAGE_ENDPOINT=
IMAGE_STORAGE_REGION=ap-chuncheon-1
IMAGE_STORAGE_BUCKET=
# OCI 공개 객체 기본 URL: https://objectstorage.<region>.oraclecloud.com/n/<namespace>/b/<bucket>/o
IMAGE_STORAGE_PUBLIC_URL=
IMAGE_STORAGE_PATH_STYLE=true
