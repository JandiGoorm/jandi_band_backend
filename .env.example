# 서버 /opt/jandi-band/{production,development}/.env에서 수동 관리
# Compose format: raw 사용. 값을 따옴표로 감싸지 않음.
# Tailscale의 TS_CLIENT_ID, TS_AUDIENCE는 GitHub Environment Variables에서 관리
DB_URL=
DB_USERNAME=
DB_PASSWORD=
JWT_SECRET=
KAKAO_REST_API_KEY=
KAKAO_ADMIN_KEY=
# Cloudflare R2 전용 자격증명과 해당 환경의 버킷·공개 주소
IMAGE_STORAGE_ACCESS_KEY=
IMAGE_STORAGE_SECRET_KEY=
IMAGE_STORAGE_ENDPOINT=
IMAGE_STORAGE_REGION=auto
IMAGE_STORAGE_BUCKET=
IMAGE_STORAGE_PUBLIC_URL=
IMAGE_STORAGE_PATH_STYLE=true
REDIS_PASSWORD=
