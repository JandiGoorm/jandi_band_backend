FROM node:22-bookworm-slim AS builder
WORKDIR /app
COPY package.json package-lock.json ./
RUN npm ci --legacy-peer-deps
COPY tsconfig.json tsconfig.app.json tsconfig.node.json vite.config.ts index.html ./
COPY src src
COPY public public
ARG KAKAO_REST_API_KEY
ARG KAKAO_JAVASCRIPT_KEY
ARG KAKAOMAP_APP_KEY
ENV VITE_API_DOMAIN=http://localhost:19090/api
ENV VITE_FRONT_URL=http://localhost:19090
ENV VITE_KAKAO_REDIRECT_URI=http://localhost:19090/callback
ENV VITE_KAKAO_CLIENT_ID=${KAKAO_REST_API_KEY}
ENV VITE_KAKAO_JAVASCRIPT_KEY=${KAKAO_JAVASCRIPT_KEY}
ENV VITE_KAKAOMAP_APP_KEY=${KAKAOMAP_APP_KEY}
RUN npx vite build
FROM nginx:stable-alpine
COPY --from=builder /app/dist /usr/share/nginx/html
